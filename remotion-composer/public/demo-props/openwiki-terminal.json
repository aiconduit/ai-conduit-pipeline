        {
          "kind": "out",
          "text": "+ openwiki cloned"
        },
        {
          "kind": "pause",
          "seconds": 0.3
        },
        {
          "kind": "cmd",
          "text": "cd openwiki && npm install"
        },
        {
          "kind": "out",
          "text": "+ 324 packages installed"
        },
        {
          "kind": "pause",
          "seconds": 0.3
        },
        {
          "kind": "pill",
          "text": "3分でWikiが完成",
          "color": "#F59E0B",
          "durationSeconds": 2
        },
        {
          "kind": "pause",
          "seconds": 0.3
        },
        {
          "kind": "cmd",
          "text": "npm run dev"
        },
        {
          "kind": "out",
          "text": "> Server running at http://localhost:3000"
        }
      ]
    },
